# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (XAMPP MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=risk_assessment_db
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS + password reset links (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Optional: send reset emails via SMTP (e.g. Gmail App Password)
# If unset, forgot-password returns resetLink in the API/UI for local/dev use.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Risk Assessment <your_account@gmail.com>"
# EMAIL_SUBJECT_RESET=Password reset — Risk Assessment Tool
